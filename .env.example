# Periplo — environment configuration template.
# Copy to .env and fill in. Never commit a real .env file (see .gitignore).
#
# Each block is tagged with the phase (master spec §5) that introduces it.
# Uncomment as the corresponding component is built — until then the
# variable does not exist in code and setting it does nothing.

# --- Runtime (Phase 0) ---
PORT=8402
NODE_ENV=development

# --- Facilitator (Phase 3) ---
# Network to operate against. Both stellar:testnet and stellar:pubnet are
# committed deliverables (spec §2) — never ship only one.
# STELLAR_NETWORK=testnet   # testnet | pubnet

# Fee-sponsorship signing key ONLY. This key pays Soroban network fees; per
# spec §1 constraint 3 it must never be capable of moving user funds, and
# the facilitator must refuse to boot if it is configured with a key that
# can. It is never the transaction source, operation source, or `from`
# address in a client payment, and never appears as a signer in a client
# auth entry (spec §3, "Facilitator safety").
# STELLAR_FEE_SPONSOR_SECRET=

# --- Data layer / Bazaar catalog (Phase 2) ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=            # public-read only, RLS-enforced — safe in a browser bundle
# SUPABASE_SERVICE_ROLE_KEY=    # bypasses RLS entirely — server-side only, never bundled to a browser (spec §2 RLS note, §6)
# SUPABASE_DB_URL=               # direct (non-pooled) connection — migrations only, needs a session, not a transaction pool
# SUPABASE_POOLER_URL=           # transaction-pooler connection — application runtime queries at scale, not yet used

# --- Conformance harness (Phase 8) ---
# Used only by the x402 e2e suite runner (conformance/RESULTS.md), on a
# funded testnet/pubnet account distinct from the fee-sponsor key above.
# STELLAR_SECRET=
