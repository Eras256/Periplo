{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "build/types",
    "rootDir": ".",
    "emitDeclarationOnly": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "allowJs": false,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "src/**/*.json", "messages/*.json", "next.config.ts"]
}
