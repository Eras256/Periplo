# See docs/DEFERRED.md: "Local Node / pnpm version drift" for why this exists.
# CI (.github/workflows/ci.yml) runs the real gate on Node 22 + pnpm 11.20.0 and
# does not set engine-strict, but pins both tools exactly via actions/setup-node
# and pnpm/action-setup. This line only relaxes the *local* dev loop, which on
# this machine currently has Node 20.19.6 / pnpm 10.30.3 preinstalled.
engine-strict=false
auto-install-peers=true
strict-peer-dependencies=false
